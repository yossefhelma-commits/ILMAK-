
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ILMAK | حساب الطالب</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f1f5fc;
            margin: 0;
            padding: 30px 15px;
            color: #17233c;
        }

        .container {
            max-width: 420px;
            margin: 40px auto;
            background: white;
            padding: 25px;
            border-radius: 18px;
            box-shadow: 0 5px 25px #00000010;
        }

        h1 {
            text-align: center;
            color: #2457d6;
        }

        .subtitle {
            text-align: center;
            color: #777;
        }

        input {
            box-sizing: border-box;
            width: 100%;
            padding: 13px;
            margin: 8px 0;
            border: 1px solid #d8deeb;
            border-radius: 9px;
            font-size: 15px;
        }

        button {
            width: 100%;
            padding: 14px;
            margin-top: 12px;
            background: #2457d6;
            color: white;
            border: none;
            border-radius: 9px;
            cursor: pointer;
            font-size: 16px;
        }

        .switch {
            text-align: center;
            margin-top: 18px;
        }

        .switch button {
            background: transparent;
            color: #2457d6;
            padding: 5px;
        }

        .hidden {
            display: none;
        }

        #message {
            text-align: center;
            color: #2457d6;
            margin-top: 15px;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>ILMAK | علمك</h1>
    <p class="subtitle">بوابتك إلى مستقبلك التعليمي</p>

    <!-- تسجيل الدخول -->
    <form id="loginForm">

        <h2>تسجيل الدخول</h2>

        <input
            type="email"
            id="loginEmail"
            placeholder="البريد الإلكتروني"
            required
        >

        <input
            type="password"
            id="loginPassword"
            placeholder="كلمة المرور"
            required
        >

        <button type="submit">دخول إلى حسابي</button>

        <div class="switch">
            ليس لديك حساب؟
            <button type="button" onclick="showRegister()">
                إنشاء حساب
            </button>
        </div>

    </form>

    <!-- إنشاء حساب -->
    <form id="registerForm" class="hidden">

        <h2>إنشاء حساب طالب</h2>

        <input
            type="text"
            id="studentName"
            placeholder="اسم الطالب"
            required
        >

        <input
            type="email"
            id="studentEmail"
            placeholder="البريد الإلكتروني"
            required
        >

        <input
            type="password"
            id="studentPassword"
            placeholder="كلمة المرور"
            minlength="8"
            required
        >

        <button type="submit">إنشاء حسابي</button>

        <div class="switch">
            لديك حساب بالفعل؟
            <button type="button" onclick="showLogin()">
                تسجيل الدخول
            </button>
        </div>

    </form>

    <p id="message"></p>

</div>

<script>

    const loginForm =
        document.getElementById("loginForm");

    const registerForm =
        document.getElementById("registerForm");

    const message =
        document.getElementById("message");

    function showRegister() {
        loginForm.classList.add("hidden");
        registerForm.classList.remove("hidden");
        message.textContent = "";
    }

    function showLogin() {
        registerForm.classList.add("hidden");
        loginForm.classList.remove("hidden");
        message.textContent = "";
    }

    registerForm.addEventListener("submit", function(event) {
        event.preventDefault();

        const name =
            document.getElementById("studentName").value;

        message.textContent =
            "أهلاً " + name + "، واجهة التسجيل تعمل بنجاح!";
    });

    loginForm.addEventListener("submit", function(event) {
        event.preventDefault();

        message.textContent =
            "واجهة تسجيل الدخول تعمل، وسنربطها بالحسابات الحقيقية لاحقاً.";
    });

</script>

</body>
</html>
